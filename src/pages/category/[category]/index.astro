---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import CategorySwitcher from "../../../components/CategorySwitcher.astro";
import MarketingBanner from "../../../components/MarketingBanner.astro";
import { site } from "../../../site.config";
import {
  getCategories,
  getPostsByCategory,
  categoryHref,
  labelize,
  postSubcategory,
} from "../../../lib/posts";
import { collectionJsonLd } from "../../../lib/seo";
import { formatCount, guideCountLabel, ui } from "../../../lib/ui";

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categories = await getCategories();
const posts = await getPostsByCategory(category.id);
const lead = posts[0];
const rest = posts.slice(1);
const subBlocks = category.subcategories
  .filter((sub) => sub.count > 0)
  .map((sub) => {
    const items = posts.filter((post) => postSubcategory(post) === sub.id).slice(0, 2);
    return { sub, items };
  })
  .filter((block) => block.items.length > 0);
const shown = new Set(subBlocks.flatMap((block) => block.items.map((post) => post.slug)));
const remainder = posts.filter((post) => !shown.has(post.slug));
const label = category.label || labelize(category.id);
const intro = (category.description || "").trim();
const t = ui(site.language);
const path = categoryHref(category.id);
const crumbs = [
  { name: site.name, path: "/" },
  { name: label, path },
];
---
<BaseLayout
  title={`${label}`}
  description={intro || `${label} — ${site.tagline}`}
  language={site.language}
  direction={site.direction}
  activeCategory={category.id}
  canonicalPath={path}
  jsonLd={collectionJsonLd({
    name: label,
    description: intro || `${label} — ${site.tagline}`,
    path,
    crumbs,
  })}
>
  <nav class="crumbs" aria-label={t.breadcrumb}>
    <a href="/">{site.name}</a>
    <span aria-hidden="true">/</span>
    <span>{label}</span>
  </nav>

  <section class="page-hero">
    <p class="section-label">{t.topic}</p>
    <h1>{label}</h1>
    {intro && <p class="lede">{intro}</p>}
    <p class="count-line">{guideCountLabel(site.language, category.count)}</p>
  </section>

  <CategorySwitcher categories={categories} current={category.id} />

  <MarketingBanner area="page_middle" activeCategory={category.id} />

  {subBlocks.length > 0 && (
    <ul class="chip-row chip-jump">
      {subBlocks.map(({ sub }) => (
        <li>
          <a class="chip" href={`#sub-${sub.id}`}>
            {sub.label}
            <span class="muted">· {formatCount(site.language, sub.count)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {subBlocks.map(({ sub, items }) => (
    <section class="section subtopic" id={`sub-${sub.id}`}>
      <div class="section-head">
        <h2>{sub.label}</h2>
        <a href={categoryHref(category.id, sub.id)}>{t.seeAll}</a>
      </div>
      {sub.description && <p class="subtopic-intro">{sub.description}</p>}
      <div class="story-grid">
        {items.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ))}

  {subBlocks.length === 0 ? (
    <section class="section">
      <div class="section-head">
        <h2>{t.allGuides}</h2>
      </div>
      {posts.length === 0 ? (
        <div class="empty">
          <p>{t.noArticlesTopic}</p>
          <a class="btn-ghost" href="/">{t.home}</a>
        </div>
      ) : (
        <>
          {lead && <PostCard post={lead} featured />}
          {rest.length > 0 && (
            <div class="story-grid story-follow">
              {rest.map((post) => <PostCard post={post} />)}
            </div>
          )}
        </>
      )}
    </section>
  ) : remainder.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>{t.moreInTopic}</h2>
      </div>
      <div class="story-grid">
        {remainder.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>
